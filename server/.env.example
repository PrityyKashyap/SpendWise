# Copy this file to .env and fill in the values. Never commit .env.

# Server
# NOTE: port 5000 is taken by macOS AirPlay Receiver (ControlCenter). It binds with
# SO_REUSEPORT, so Node reports a successful listen but never receives requests.
# Use 5001, or turn off System Settings > General > AirDrop & Handoff > AirPlay Receiver.
PORT=5001
NODE_ENV=development

# The exact origin of the React app. Used for CORS.
# Must not be "*" — credentialed cookie requests (Phase 2) are rejected against
# a wildcard origin.
CLIENT_URL=http://localhost:5173

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/spendwise
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/spendwise?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/spendwise

# --- Authentication ---
# Two DIFFERENT secrets, 32+ characters each. The server refuses to start if
# they are missing, too short, or identical.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
